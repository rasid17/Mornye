# Builds Mornye from this checkout and packages it for Arch Linux and
# derivatives. Releases are built and published by GitHub Actions; this
# package is the local build of whatever the checkout holds.
#
#   cd packaging/arch && makepkg -si
#
# Needs the toolchain the repository builds with: Flutter (the version in
# .fvmrc) on PATH, Rust (rust_backend/rust-toolchain.toml) and the Linux
# desktop build tools (clang, cmake, ninja, pkg-config, GTK 3 headers). They
# are not makedepends, as Flutter has no Arch package and a rustup install
# would conflict with the rust package.
#
# Differences from a GitHub release: Flutter's semantics patch
# (patches/flutter) is not applied to the local SDK, and no Last.fm keys are
# compiled in. The LGPL FFmpeg tools are fetched once into build/ffmpeg and
# bundled like a release.

pkgname=mornye
pkgver=5.4.0.r4725.gd0eaf03
pkgrel=1
pkgdesc='Music player for local files and streams (rasid17 fork, local build)'
arch=('x86_64' 'aarch64')
url='https://github.com/rasid17/Mornye'
license=('LicenseRef-Mornye')
# libmpv is opened at run time by media_kit, so it is not in any NEEDED entry.
depends=(
  'alsa-lib' 'cairo' 'fontconfig' 'gdk-pixbuf2' 'glib2' 'glibc'
  'gst-plugins-base-libs' 'gstreamer' 'gtk3' 'harfbuzz' 'json-glib'
  'lame' 'libepoxy' 'libsecret' 'libsoxr' 'libvorbis' 'opencore-amr' 'opus'
  'pango' 'speex' 'twolame' 'wayland' 'zlib'
  'libgcc_s.so' 'libstdc++.so' 'libmpv.so'
)
# The bundle ships Flutter's AOT snapshot and prebuilt libraries; stripping
# them can break the snapshot. The repository's build scripts pick their own
# compiler flags, as the GitHub builds do, so makepkg's are left out.
options=('!strip' '!debug' '!buildflags' '!lto')
provides=('mornye')
conflicts=('mornye-bin')

_repo="$(realpath "${startdir}/../..")"

_flutter_arch() {
  case "${CARCH}" in
    x86_64) echo x64 ;;
    aarch64) echo arm64 ;;
  esac
}

pkgver() {
  cd "${_repo}"
  local version
  version="$(sed -n 's/^version: *\([0-9.]*\).*/\1/p' pubspec.yaml)"
  printf '%s.r%s.g%s' "${version}" "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "${_repo}"
  local arch
  arch="$(_flutter_arch)"

  bash scripts/build_rust_backend.sh desktop
  if [[ ! -x "build/ffmpeg/linux-${arch}/ffmpeg" ]]; then
    bash scripts/fetch_desktop_ffmpeg.sh "linux-${arch}"
  fi
  flutter pub get
  flutter build linux --release --target lib/main.dart \
    --dart-define="GIT_COMMIT=$(git rev-parse --short=8 HEAD)"

  local bundle="build/linux/${arch}/release/bundle"
  test -x "${bundle}/mornye"
  test -s "${bundle}/lib/libmornye_desktop.so"
  test -x "${bundle}/lib/ffmpeg/ffmpeg"
  test -x "${bundle}/lib/ffmpeg/ffprobe"
}

package() {
  cd "${_repo}"
  local app_id=com.zarz.mornye
  local bundle="build/linux/$(_flutter_arch)/release/bundle"

  install -d "${pkgdir}/usr/lib/${pkgname}" "${pkgdir}/usr/bin"
  cp -a "${bundle}/." "${pkgdir}/usr/lib/${pkgname}/"
  ln -s "../lib/${pkgname}/${pkgname}" "${pkgdir}/usr/bin/${pkgname}"

  install -Dm644 "linux/packaging/${app_id}.desktop" \
    "${pkgdir}/usr/share/applications/${app_id}.desktop"
  install -Dm644 "linux/packaging/${app_id}.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/${app_id}.metainfo.xml"
  local size
  for size in 128 256; do
    install -Dm644 "linux/packaging/icons/mornye-${size}.png" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/${app_id}.png"
  done
  install -Dm644 assets/brand/logo/png/mornye-badge@1x.png \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${app_id}.png"
  install -Dm644 assets/brand/logo/svg/mornye-badge.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${app_id}.svg"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -m644 COPYING NOTICE "${pkgdir}/usr/share/licenses/${pkgname}/"
}
